# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Broker Abstraction Layer Configuration (Sprint 27 & 28)
TRADING_MODE="PAPER_TRADING"
BROKER_TYPE="MOCK"
CACHE_LOCATION="instrument_cache"
HEARTBEAT_INTERVAL_SECONDS=30
RECONNECT_ATTEMPTS=3
REQUEST_TIMEOUT_SECONDS=10.0

# Zerodha KiteConnect Session & Authentication Config (Sprint 28)
KITE_API_KEY=""
KITE_API_SECRET=""
KITE_REDIRECT_URL="http://127.0.0.1:3000/api/broker/callback"
SESSION_CACHE_PATH=".cache/session.json"
AUTO_LOAD_SESSION="True"
AUTO_VALIDATE_SESSION="True"
CONNECTION_TIMEOUT=10.0

# Workspace Operating Mode Configuration (Sprint 29)
WORKSPACE_MODE=""
DEFAULT_WORKSPACE_MODE="DEVELOPMENT"
ALLOW_LIVE_TRADING="False"
REQUIRE_CONFIRMATION="True"
SHOW_MODE_WARNING="True"
AUTO_FALLBACK_TO_DEVELOPMENT="True"

# Custom Simulated Zerodha Broker Credentials (optional for Live Trading simulation mode customization)
KITE_CLIENT_ID="MOCK_CLIENT"
KITE_CLIENT_NAME="Mock User"
KITE_EMAIL="mock@example.com"
KITE_AVAILABLE_CASH="1000000.0"

