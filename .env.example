# Environment Configuration Example for AIR ArdhaMind
# DO NOT COMMIT REAL SECRETS TO VERSION CONTROL

# Workspace & Server Settings
PORT=3000
WORKSPACE_MODE=READ_ONLY
ALLOW_LIVE_TRADING=False
TRADING_MODE=LIVE_ZERODHA
BROKER_TYPE=ZERODHA
PREFERRED_TRADING_STYLE=Intraday

# Dedicated Zerodha Kite OAuth Credentials
KITE_API_KEY=your_kite_api_key_here
KITE_API_SECRET=your_kite_api_secret_here
KITE_REDIRECT_URL=http://127.0.0.1:3000/api/broker/callback

# Bounded OpenAI Interpretation Layer (Optional)
OPENAI_API_KEY=

# Optional structured financial-news adapter. Leave blank to keep it observably disabled.
FINANCIAL_NEWS_PROVIDER=
FINANCIAL_NEWS_API_KEY=

# E3 economic calendar. Official providers work without credentials. The
# optional structured vendor adapter remains disabled unless both are set.
ECONOMIC_CALENDAR_PROVIDER=
ECONOMIC_CALENDAR_API_KEY=

# Phase Preview Controls (Optional: Set true to enable interactive manual session phase preview buttons)
VITE_ENABLE_PHASE_PREVIEW=false
